# LINE Messaging API
# LINE DevelopersコンソールのMessaging API設定から取得してください
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Claude API (Anthropic)
# 未設定の場合はモックテンプレートで動作します
# https://console.anthropic.com/ から取得してください
# ANTHROPIC_API_KEY=sk-ant-api03-...

# サーバー設定
PORT=3000
# セキュリティ: デフォルトは 127.0.0.1（ローカルのみ）。
# ngrok を使う場合はこのままでOK。
# 外部ネットワークに直接公開する場合のみ 0.0.0.0 に変更してください。
HOST=127.0.0.1

# データベース設定
# 省略時は ./data/dev.db が使われます
# DB_PATH=./data/orchestrator.db

# ワークスペース設定
# 生成されるプロジェクトファイルの保存先
# 省略時は ./workspace が使われます
# WORKSPACE_ROOT=./workspace

# ログレベル (error, warn, info, debug)
LOG_LEVEL=info

# 環境 (development, production, test)
NODE_ENV=development

# ngrok (Electronアプリからngrokを自動起動する場合に設定)
# ngrok ダッシュボード → Your Authtoken から取得
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# ngrok ダッシュボード → Domains から確認
# NGROK_DOMAIN=promenade-tinwork-masculine.ngrok-free.dev
