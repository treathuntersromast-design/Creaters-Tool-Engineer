{
  "name": "line-ai-dev-orchestrator",
  "version": "0.1.0",
  "description": "LINE Messaging API driven AI development team orchestrator",
  "author": "Creaters Tool Engineer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "electron:compile": "tsc -p tsconfig.electron.json && xcopy /E /I /Y electron\\renderer dist-electron\\renderer > nul",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "npm run build && npm run electron:compile && node scripts/launch-electron.js dist-electron/main.js",
    "electron:build": "npm run build && npm run electron:compile && electron-packager . \"Creaters Tool Engineer\" --platform=win32 --arch=x64 --out=release --overwrite --electron-version=33.4.11 --no-asar --ignore=\"^/(release|tests|electron|src)($|/)\" --ignore=\"\\.ts$\""
  },
  "build": {
    "appId": "com.creaters-tool-engineer.app",
    "productName": "Creaters Tool Engineer",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache/**",
      "!**/node_modules/electron-builder/**",
      "!**/node_modules/electron/dist/**"
    ],
    "extraResources": [
      {
        "from": "electron/renderer",
        "to": "renderer"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
